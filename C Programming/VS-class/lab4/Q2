#include <stdio.h>

int main() {
    int n, sum = 0;
    printf("Enter a four-digit number: ");
    scanf("%d", &n);

    sum += n % 10;       // units place
    n = n / 10;
    sum += n % 10;       // tens place
    n = n / 10;
    sum += n % 10;       // hundreds place
    n = n / 10;
    sum += n % 10;       // thousands place

    printf("Sum of the digits = %d\n", sum);
    return 0;
} 