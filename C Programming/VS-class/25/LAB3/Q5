#include<stdio.h>
#include<math.h>
int main (){
    float dr,sc,hc;
    float EOQ,TBO;

printf("Enter dr");
scanf ("%f",&dr);
printf("Enter sc");
scanf("%f,&sc");
printf("Enter hc");
scanf("%f",&hc);
 
EOQ = sqrt((2*dr*sc)/hc);
TBO = sqrt((2*sc)/(dr*hc));

printf("EOQ %f \n",EOQ);
printf("TBO %f \n",TBO);
return 0;
}
